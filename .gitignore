__pycache__/
*.py[cod]
.venv/
venv/
.env

# dist/*.html, dist/*.txt and dist/resume.json ARE committed on purpose: the
# text layer is the artifact under review, so a parsing regression shows up as
# a reviewable diff. The PDFs are binaries regenerated by CI on every push and
# published to Pages, so they do not belong in git history.
dist/*.pdf

# Local verification scratch (screenshots, forced print previews).
dist/_*
